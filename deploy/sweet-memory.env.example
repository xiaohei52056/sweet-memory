# 星河回忆生产环境变量（部署到服务器 /opt/sweet-memory/sweet-memory.env）
# ⚠️ 本文件含敏感信息，权限应设为 600，且已在 .gitignore 中排除，切勿提交
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sweet
DB_PASSWORD=请替换为服务器MySQL的sweet账号密码
APP_UPLOAD_DIR=/opt/sweet-memory/data/uploads
APP_JWT_SECRET=请替换为随机64位十六进制字符串
ADMIN1_USER=star
ADMIN1_HASH=$2a$10$请填入star密码的bcrypt哈希
ADMIN1_NICK=Star
ADMIN2_USER=river
ADMIN2_HASH=$2a$10$请填入river密码的bcrypt哈希
ADMIN2_NICK=River
